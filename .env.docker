# ============================================================
# .env untuk Docker Compose
# Salin file ini menjadi .env lalu sesuaikan nilainya
# JANGAN commit file .env ke repository!
# ============================================================

# ── Aplikasi ──────────────────────────────────────────────
NODE_ENV=production
PORT=4000
TZ=Asia/Jakarta
APP_TIMEZONE=Asia/Jakarta

# ── Database PostgreSQL ───────────────────────────────────
# OPSI A: Menggunakan PostgreSQL Eksternal / Host Machine (Default)
DB_HOST=host.docker.internal
DB_PORT=5434
# COMPOSE_PROFILES=

# OPSI B: Menggunakan PostgreSQL Kontainer Docker
# DB_HOST=postgres
# DB_PORT=5432
# COMPOSE_PROFILES=postgres
# DB_PORT_EXPOSE=5434

DB_USERNAME=root
DB_PASSWORD=root
DB_NAME=app

# ── Redis ──────────────────────────────────────────────────
REDIS_TTL=3600
# Port yang diekspos ke host (untuk debugging, hapus jika tidak perlu)
REDIS_PORT_EXPOSE=6378

# ── JWT ────────────────────────────────────────────────────
# WAJIB diganti! Gunakan string random yang panjang dan kompleks.
# Generate: openssl rand -base64 64
JWT_SECRET=ahsd8723hjg81hjs7d1hsd81hdg1283h1s87d1ghsd
JWT_EXPIRES_IN=10h
JWT_REFRESH_EXPIRES_IN=1d

# ── CORS / Frontend ────────────────────────────────────────
NODE_ENV=production
ALLOWED_ORIGINS=https://dlinzi.web.id,http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000
